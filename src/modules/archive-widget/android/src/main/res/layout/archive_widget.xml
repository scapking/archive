<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色档 widget 卡面（深色档 layout-night + values-night 同构换色）。v0.4.7：每行 = 时间 / 标题 / 阶段徽章三段（堆叠视觉层次，
     分档颜色由 provider 按 status 用 setTextColor 上色，色板见 values/-night archive_widget_colors.xml）。点击深链
     archive://trip/<id>（路径参数，AGENTS.md 偏差表）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@color/archive_widget_bg">

    <TextView
        android:id="@+id/widget_trip_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/archive_widget_text"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="行程" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="@color/archive_widget_secondary"
        android:text="打开 Archive，行程会出现在这里" />

    <LinearLayout
        android:id="@+id/widget_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_row_0_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/archive_widget_secondary"
            android:fontFeatureSettings="tnum"
            android:paddingEnd="10dp" />
        <TextView
            android:id="@+id/widget_row_0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/archive_widget_text"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_row_0_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/archive_widget_muted"
            android:maxLines="1"
            android:paddingStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_row_1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/archive_widget_secondary"
            android:fontFeatureSettings="tnum"
            android:paddingEnd="10dp" />
        <TextView
            android:id="@+id/widget_row_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/archive_widget_text"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_row_1_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/archive_widget_muted"
            android:maxLines="1"
            android:paddingStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_row_2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/archive_widget_secondary"
            android:fontFeatureSettings="tnum"
            android:paddingEnd="10dp" />
        <TextView
            android:id="@+id/widget_row_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/archive_widget_text"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_row_2_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/archive_widget_muted"
            android:maxLines="1"
            android:paddingStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_row_3_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/archive_widget_secondary"
            android:fontFeatureSettings="tnum"
            android:paddingEnd="10dp" />
        <TextView
            android:id="@+id/widget_row_3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/archive_widget_text"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_row_3_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/archive_widget_muted"
            android:maxLines="1"
            android:paddingStart="8dp" />
    </LinearLayout>
</LinearLayout>
