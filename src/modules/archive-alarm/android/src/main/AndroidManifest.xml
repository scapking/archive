<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 精确闹钟（Android 12+ 需用户在系统设置授予；低版本静默可用）。
         决策注（v0.4.7 用户令 #2「补全权限声明」）：同时声明 USE_EXACT_ALARM
         （Android 13+ 自动授予、免跳设置）——闹钟/日历类 app 的标准做法，
         本 app 行程闹钟属用户显式配置的到点强提醒语义；注意 Play 对非
         闹钟/日历类 app 发放 USE_EXACT_ALARM 有审核政策风险，若走 Play 分发
         被拒，删除本行即回到 SCHEDULE_EXACT_ALARM 用户授权档（代码无需改：
         AlarmScheduler.canExact 本就双档自适应）。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 闹钟触发通知（Android 13+ 运行时权限） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 到点全屏呈现（锁屏上直接弹响铃面） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 重启后重排全部未触发闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 到点常驻通知保活（用户令 #2：前台服务维持存活，确认后移除）。
         Android 14+ FGS 必须带类型，本服务类型 = alarm -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_ALARM" />

    <application>
        <!-- 闹钟到点接收器：仅本 app 内部显式 intent 触发（不导出） -->
        <receiver
            android:name="archive.alarm.AlarmFireReceiver"
            android:exported="false" />
        <!-- 到点保活前台服务（v0.4.7）：常驻通知认领 + JS 全屏闹钟存活面 -->
        <service
            android:name="archive.alarm.AlarmKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="alarm" />
        <!-- 开机重排：系统广播（必须导出 + intent-filter） -->
        <receiver
            android:name="archive.alarm.BootRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>