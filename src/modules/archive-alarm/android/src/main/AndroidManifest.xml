<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 精确闹钟（Android 12+ 需用户在系统设置授予；低版本静默可用）。
         决策注（v0.4.7 用户令 #2「补全权限声明」）：同时声明 USE_EXACT_ALARM
         （Android 13+ 自动授予、免跳设置）——闹钟/日历类 app 的标准做法，
         本 app 行程闹钟属用户显式配置的到点强提醒语义；注意 Play 对非
         闹钟/日历类 app 发放 USE_EXACT_ALARM 有审核政策风险，若走 Play 分发
         被拒，删除本行即回到 SCHEDULE_EXACT_ALARM 用户授权档（代码无需改：
         AlarmScheduler.canExact 本就双档自适应）。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 闹钟触发通知（Android 13+ 运行时权限） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 到点全屏呈现（锁屏上直接弹响铃面） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 重启后重排全部未触发闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 到点常驻通知保活（用户令 #2：前台服务维持存活，确认后移除）。
         Android 14+ FGS 必须带类型。类型选型注（0.4.7 CI 两轮实测）：
         「alarm」FGS 类型是 Android 15 才引入的枚举（ServiceInfo 常量与
         manifest attr flags 同源于 35），本项目编译链的 AAPT 属性域没有它
         （'alarm' is incompatible with attribute foregroundServiceType），
         故走 specialUse + subtype 申报（34 起可用，语义=闹钟保活自述），
         FOREGROUND_SERVICE_ALARM 权限一并换成 SPECIAL_USE；待 compileSdk
         到 35+ 且 Play 政策允许时可一行切回 alarm。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <!-- 闹钟到点接收器：仅本 app 内部显式 intent 触发（不导出） -->
        <receiver
            android:name="archive.alarm.AlarmFireReceiver"
            android:exported="false" />
        <!-- 到点保活前台服务（v0.4.7）：常驻通知认领 + JS 全屏闹钟存活面；
             specialUse+subtype 申报闹钟保活语义（见上方类型选型注） -->
        <service
            android:name="archive.alarm.AlarmKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="trip-alarm-keep-alive" />
        </service>
        <!-- v0.5.2 令3 常驻监控前台服务（用户：「创建行程的时候就创建常驻通知，
             否则后台会冻结没办法使用」）：pending 闹钟在场期间「N 个行程提醒
             监控中」静默状态行常驻（独立渠道、无声音无 FSI——与到点保活服务
             分服务分通知，一个 FGS 只挂一条通知，混用即 v0.5.1 FSI 剥离教训
             重演）；specialUse+subtype 申报类型选型同 AlarmKeepAliveService 注 -->
        <service
            android:name="archive.alarm.AlarmMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="trip-alarm-monitor" />
        </service>
        <!-- 开机重排：系统广播（必须导出 + intent-filter） -->
        <receiver
            android:name="archive.alarm.BootRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>